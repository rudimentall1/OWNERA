[Unit]
Description=OWNERA authenticated NEAR Agent Market assignment intake
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/OWNERA
EnvironmentFile=/etc/ownera/near-agent-market.env
ExecStart=/opt/OWNERA/.venv/bin/ownera paid-work sync-near-assignments --database /var/lib/ownera/ownera.sqlite3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/ownera
